# bigint-buffer (GHSA-3gc7-fjrx-p6mg) has no upstream fix — it requires @solana/spl-token
# to drop bigint-buffer, which they have not yet done. npm audit fix --force would
# downgrade @solana/spl-token to 0.1.8 (a breaking change). Set audit-level to critical
# so `npm install` exits cleanly; run `npm audit` manually to see the advisory.
audit-level=critical
